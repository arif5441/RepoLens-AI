# Copy to .env and fill in local values. Never commit .env.

# --- Application ---
APP_ENV=development
APP_LOG_LEVEL=INFO

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:4200

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=repolens
MYSQL_USER=repolens
MYSQL_PASSWORD=

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Frontend ---
FRONTEND_API_BASE_URL=http://localhost:8000
