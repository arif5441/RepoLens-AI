# Copy to .env and fill in local values. Never commit .env.

# --- Application ---
APP_ENV=development
APP_LOG_LEVEL=INFO

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:4200

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=repolens
MYSQL_USER=repolens
MYSQL_PASSWORD=

# --- Ollama ---
# phi3:mini is the default: small (~2.3GB), fast on CPU-only machines.
# Swap to a larger/code-specialized model (e.g. qwen2.5-coder:7b) once your
# hardware/available RAM supports it — no code changes needed, just `ollama pull` + this value.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# 180s, not 60 — a RAG answer with retrieved code context takes noticeably longer than a
# plain chat reply on CPU-only inference (real observed range: ~100-115s with 3-5 chunks
# of context). 60s genuinely timed out during this project's own testing.
OLLAMA_CHAT_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.3

# --- Embeddings ---
# all-MiniLM-L6-v2: 384 dimensions, ~90MB, fast on CPU. Good general-purpose default
# for local semantic search. Must stay consistent for a given set of stored vectors —
# changing it later means re-embedding everything, since different models produce
# vectors that aren't comparable to each other.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true

# --- GitHub Ingestion ---
# Optional. Public repos work without a token (60 requests/hour). Set a token
# (classic PAT, no scopes needed for public repos) to raise that limit if you
# hit it during testing. Never required — do not make auth mandatory here.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com
INGESTION_HTTP_TIMEOUT_SECONDS=15
INGESTION_MAX_FILES=300
INGESTION_MAX_FILE_SIZE_BYTES=200000
INGESTION_MAX_TOTAL_SIZE_BYTES=20000000

# --- Chunking ---
# Max lines per code chunk. Larger functions/classes get sub-split at this size.
CHUNK_MAX_LINES=80

# --- RAG ---
RAG_TOP_K=5
# Chunks scoring below this cosine-similarity threshold are treated as not relevant —
# if nothing clears it, the LLM is never called; a fixed "insufficient evidence" answer
# is returned instead.
RAG_MIN_SIMILARITY=0.2
# Character (not token) budget for the context handed to the LLM. See docs/architecture/
# overview.md for why character count, not a real tokenizer, is used here.
RAG_MAX_CONTEXT_CHARS=6000

# --- Frontend ---
FRONTEND_API_BASE_URL=http://localhost:8000
